:"chuāng","t1":"chuāng"},"sha":{"zh":"沙","py":"shā","t1":"shā"},"she":{"zh":"奢","py":"shē","t1":"shē"},"shi":{"zh":"诗","py":"shī","t1":"shī"},"shai":{"zh":"筛","py":"shāi","t1":"shāi"},"shei":{"zh":"谁","py":"shéi","t1":"shēi"},"shao":{"zh":"烧","py":"shāo","t1":"shāo"},"shou":{"zh":"收","py":"shōu","t1":"shōu"},"shan":{"zh":"山","py":"shān","t1":"shān"},"shen":{"zh":"身","py":"shēn","t1":"shēn"},"shang":{"zh":"伤","py":"shāng","t1":"shāng"},"sheng":{"zh":"生","py":"shēng","t1":"shēng"},"shu":{"zh":"书","py":"shū","t1":"shū"},"shua":{"zh":"刷","py":"shuā","t1":"shuā"},"shuo":{"zh":"说","py":"shuō","t1":"shuō"},"shuai":{"zh":"摔","py":"shuāi","t1":"shuāi"},"shui":{"zh":"水","py":"shuǐ","t1":"shuī"},"shuan":{"zh":"栓","py":"shuān","t1":"shuān"},"shun":{"zh":"顺","py":"shùn","t1":"shūn"},"shuang":{"zh":"双","py":"shuāng","t1":"shuāng"},"re":{"zh":"热","py":"rè","t1":"rē"},"ri":{"zh":"日","py":"rì","t1":"rī"},"rao":{"zh":"绕","py":"rào","t1":"rāo"},"rou":{"zh":"肉","py":"ròu","t1":"rōu"},"ran":{"zh":"然","py":"rán","t1":"rān"},"ren":{"zh":"人","py":"rén","t1":"rēn"},"rang":{"zh":"让","py":"ràng","t1":"rāng"},"reng":{"zh":"扔","py":"rēng","t1":"rēng"},"rong":{"zh":"容","py":"róng","t1":"rōng"},"ru":{"zh":"如","py":"rú","t1":"rū"},"ruo":{"zh":"弱","py":"ruò","t1":"ruō"},"rui":{"zh":"瑞","py":"ruì","t1":"ruī"},"ruan":{"zh":"软","py":"ruǎn","t1":"ruān"},"run":{"zh":"润","py":"rùn","t1":"rūn"},"za":{"zh":"杂","py":"zá","t1":"zā"},"ze":{"zh":"则","py":"zé","t1":"zē"},"zi":{"zh":"资","py":"zī","t1":"zī"},"zai":{"zh":"灾","py":"zāi","t1":"zāi"},"zei":{"zh":"贼","py":"zéi","t1":"zēi"},"zao":{"zh":"糟","py":"zāo","t1":"zāo"},"zou":{"zh":"走","py":"zǒu","t1":"zōu"},"zan":{"zh":"咱","py":"zán","t1":"zān"},"zen":{"zh":"怎","py":"zěn","t1":"zēn"},"zang":{"zh":"脏","py":"zāng","t1":"zāng"},"zeng":{"zh":"增","py":"zēng","t1":"zēng"},"zong":{"zh":"宗","py":"zōng","t1":"zōng"},"zu":{"zh":"租","py":"zū","t1":"zū"},"zuo":{"zh":"做","py":"zuò","t1":"zuō"},"zui":{"zh":"最","py":"zuì","t1":"zuī"},"zuan":{"zh":"钻","py":"zuān","t1":"zuān"},"zun":{"zh":"尊","py":"zūn","t1":"zūn"},"ca":{"zh":"擦","py":"cā","t1":"cā"},"ce":{"zh":"册","py":"cè","t1":"cē"},"ci":{"zh":"词","py":"cí","t1":"cī"},"cai":{"zh":"猜","py":"cāi","t1":"cāi"},"cao":{"zh":"操","py":"cāo","t1":"cāo"},"cou":{"zh":"凑","py":"còu","t1":"cōu"},"can":{"zh":"餐","py":"cān","t1":"cān"},"cen":{"zh":"岑","py":"cén","t1":"cēn"},"cang":{"zh":"仓","py":"cāng","t1":"cāng"},"ceng":{"zh":"层","py":"céng","t1":"cēng"},"cong":{"zh":"聪","py":"cōng","t1":"cōng"},"cu":{"zh":"粗","py":"cū","t1":"cū"},"cuo":{"zh":"搓","py":"cuō","t1":"cuō"},"cui":{"zh":"催","py":"cuī","t1":"cuī"},"cuan":{"zh":"窜","py":"cuàn","t1":"cuān"},"cun":{"zh":"村","py":"cūn","t1":"cūn"},"sa":{"zh":"撒","py":"sā","t1":"sā"},"se":{"zh":"色","py":"sè","t1":"sē"},"si":{"zh":"思","py":"sī","t1":"sī"},"sai":{"zh":"腮","py":"sāi","t1":"sāi"},"sao":{"zh":"扫","py":"sǎo","t1":"sāo"},"sou":{"zh":"搜","py":"sōu","t1":"sōu"},"san":{"zh":"三","py":"sān","t1":"sān"},"sen":{"zh":"森","py":"sēn","t1":"sēn"},"sang":{"zh":"桑","py":"sāng","t1":"sāng"},"seng":{"zh":"僧","py":"sēng","t1":"sēng"},"song":{"zh":"松","py":"sōng","t1":"sōng"},"su":{"zh":"苏","py":"sū","t1":"sū"},"suo":{"zh":"缩","py":"suō","t1":"suō"},"sui":{"zh":"虽","py":"suī","t1":"suī"},"suan":{"zh":"酸","py":"suān","t1":"suān"},"sun":{"zh":"孙","py":"sūn","t1":"sūn"}},"tone_default":1,"notes_vi":["b/d/g của pinyin KHÔNG phải âm hữu thanh như b/đ/g tiếng Việt: b ≈ 'p' (pin), d ≈ 't', g ≈ 'c/k'. Cặp b–p, d–t, g–k chỉ khác nhau ở chỗ có bật hơi hay không.","zh/ch/sh/r là nhóm uốn lưỡi (đầu lưỡi cong lên chạm ngạc cứng): zh ≈ 'tr', ch = 'tr' bật hơi, sh ≈ 's' uốn lưỡi, r ≈ 'r' không rung. Người miền Bắc cần tập uốn lưỡi rõ để không lẫn với z/c/s.","z/c/s là nhóm đầu lưỡi thẳng (chạm sau răng): z ≈ 'tx' không bật hơi, c = 'tx' bật hơi, s ≈ 'x' tiếng Việt. Chữ 'c' pinyin không bao giờ đọc là 'k'.","j/q/x là nhóm mặt lưỡi (mặt lưỡi áp ngạc cứng, môi dẹt): j ≈ 'ch', q = 'ch' bật hơi, x ≈ 'x' mềm. Nhóm này chỉ đi với i và ü; khi đó 'u' viết sau j/q/x thực ra là 'ü' (ju, qu, xu, yu = jü, qü, xü, yü).","ü: giữ lưỡi ở vị trí 'i' rồi tròn môi như 'u'. Chỉ viết hai chấm sau n và l (nü, lü, nüe, lüe) để phân biệt với nu, lu.","e đứng một mình hoặc sau phụ âm (ge, ke, he, de, le) đọc gần 'ơ/ưa', không phải 'e' tiếng Việt. Trong ie, üe, ei thì e đọc như 'ê'.","i sau z/c/s/zh/ch/sh/r không đọc là 'i' mà gần 'ư' (zi, ci, si, zhi, chi, shi, ri): chỉ kéo dài phụ âm cho có tiếng.","er: đọc 'ơ' rồi cong đầu lưỡi. Hậu tố 儿 (-r) ở cuối từ làm vần trước đó uốn lưỡi (花儿 huār, 一点儿 yìdiǎnr).","-n và -ng: -n kết thúc bằng đầu lưỡi chạm lợi trên (an, en, in), -ng kết thúc ở gốc lưỡi (ang, eng, ing). Tiếng Việt cũng phân biệt nên người Việt có lợi thế; chú ý in ≠ ing, en ≠ eng.","Vần viết rút gọn: iu = iou, ui = uei, un = uen. Vì vậy liu đọc 'li-âu', dui đọc 'tu-ây', lun đọc 'lu-ân'.","ian đọc 'i-en' (như 'iên'), không phải 'i-an'; üan (juan, quan, xuan, yuan) đọc 'uy-en'.","Âm tiết không có thanh mẫu: i/u/ü đứng đầu viết thành y/w/yu (yi, wu, yu, ya, wo, yue…). y và w chỉ là quy ước chính tả, không phải phụ âm mới.","Dấu thanh đặt trên nguyên âm chính theo thứ tự ưu tiên a → o → e; với iu và ui thì đặt trên chữ đứng sau (liú, duì).","Tiếng phổ thông không có âm cuối -m, -p, -t, -k như tiếng Việt; mọi âm tiết chỉ kết thúc bằng nguyên âm, -n, -ng hoặc -r."],"notes_en":["Pinyin b/d/g are not voiced: they are unaspirated p/t/k (as in 'spy', 'sty', 'sky'). The pairs b–p, d–t, g–k differ only in aspiration.","zh/ch/sh/r are retroflex: curl the tongue tip back toward the hard palate. Keep them distinct from z/c/s.","z/c/s are made with a flat tongue tip behind the teeth: z = 'ds', c = 'ts' with a puff of air, s = s. Pinyin 'c' is never pronounced k.","j/q/x are palatal: tongue flat against the palate, lips spread. They only combine with i and ü, so 'u' written after j/q/x/y is really ü (ju, qu, xu, yu).","ü: hold the tongue for 'ee' and round the lips. The two dots are written only after n and l (nü, lü, nüe, lüe).","e alone or after a consonant (ge, ke, he, de, le) is a back unrounded vowel, roughly 'uh'. In ie, üe and ei it sounds like the e in 'yes' / 'hey'.","i after z/c/s/zh/ch/sh/r is not 'ee': just keep voicing the consonant (zi, ci, si, zhi, chi, shi, ri).","er is 'uh' with a curled tongue. The suffix 儿 (-r) rhotacises the preceding final (花儿 huār, 一点儿 yìdiǎnr).","-n ends with the tongue tip on the gum ridge (an, en, in); -ng ends at the back of the tongue (ang, eng, ing). Keep in ≠ ing and en ≠ eng.","Abbreviated finals: iu = iou, ui = uei, un = uen. So liu sounds like 'lyoh', dui like 'dway', lun like 'lwun'.","ian is pronounced 'yen', not 'yan'; üan (juan, quan, xuan, yuan) is ü + 'en'.","Syllables without an initial: leading i/u/ü are written y/w/yu (yi, wu, yu, ya, wo, yue…). y and w are spelling conventions only.","The tone mark goes on the main vowel in the priority a → o → e; in iu and ui it goes on the last letter (liú, duì).","Mandarin syllables end only in a vowel, -n, -ng or -r; there are no final -m, -p, -t, -k."],"rv":"ai"}